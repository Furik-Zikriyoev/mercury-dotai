# Скопировать в .env (локально) или вписать в Vercel → Settings → Environment Variables.
# .env в git не попадает.

# Секрет подписи токенов входа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# База. Локально можно не задавать — будет файл data/local.db.
# На Vercel — адрес и токен базы Turso (turso.tech).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# OpenAI. Лимит расходов ставится в platform.openai.com → Settings → Limits
OPENAI_API_KEY=
# OPENAI_ANALYZE_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4.1

# Steam ID64 профиля, который видят гости в демо. Профиль Dota должен быть публичным.
DEMO_STEAM_ID=

# Лимиты запросов к ИИ в сутки
# AI_LIMIT_USER=40
# AI_LIMIT_DEMO=8
# AI_LIMIT_GLOBAL=300

# Почта для сброса пароля (mail.ru, пароль приложения). Без неё сброс не работает.
EMAIL_USER=
EMAIL_PASS=
# Адрес сайта — для ссылки в письме
APP_URL=http://localhost:3000
